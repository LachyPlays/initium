{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sample (msvc with vsdbg)",
            "type": "cppvsdbg",              
            "request": "launch",
            "program": "${workspaceFolder}/build/samples/${input:sampleExecutable}/Debug/${input:sampleExecutable}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/samples/${input:sampleExecutable}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "CMake: Build Project"
        },
        {
            "name": "Debug Sample (Ninja with vsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/samples/${input:sampleExecutable}/${input:sampleExecutable}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/samples/${input:sampleExecutable}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "CMake: Build Project"
        },
        {
            "name": "Debug Sample (Ninja with gdb)",
            "type": "cppdbg",
            "MIMode": "gdb",           
            "request": "launch",
            "program": "${workspaceFolder}/build/samples/${input:sampleExecutable}/${input:sampleExecutable}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/samples/${input:sampleExecutable}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "CMake: Build Project"
        }
    ],
    "inputs": [
        {
            "id": "sampleExecutable",
            "type": "pickString",
            "description": "Select sample to debug",
            "options": ["hello_triangle", "hello_cube", "textured_cube", "suzanne_test"],
            "default": "hello_triangle"
        }
    ]
}